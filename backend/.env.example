# Copy to .env and fill in required values
# Required
DATABASE_URL=

# Required when AI_AGENT_PROVIDER=gemini
GEMINI_API_KEY=

# Optional — override defaults shown below
AI_AGENT_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.2

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_TEMPERATURE=0.2


AI_MAX_ATTACHMENT_BYTES=10485760   # 10 MB
AI_URL_FETCH_CAP=5
AI_URL_STRIP_CHARS=20000
AI_SOURCE_EXCERPT_CHARS=500
AI_TASK_TITLE_MAX_CHARS=500

PROMPT_VERSION=v2

# Comma-separated or JSON array, e.g. ["http://localhost:5173","https://myapp.com"]
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Memory integration (MemPalace)
MEMORY_ENABLED=false
MEMORY_PALACE_ROOT=/app/.mempalace
MEMORY_DEFAULT_RESULTS=5
MEMORY_MAX_CONTEXT_CHARS=2500
MEMORY_ALLOWED_SCOPE_WIDENING=true
MEMORY_REDACTION_ENABLED=true
MEMORY_COMMAND_TIMEOUT_SECONDS=20
